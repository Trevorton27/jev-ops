# JevOps Configuration
JEVOPS_DEBUG=false
JEVOPS_ENVIRONMENT=development
JEVOPS_LOG_LEVEL=INFO
JEVOPS_LOG_FORMAT=console

# Database
JEVOPS_DB_HOST=localhost
JEVOPS_DB_PORT=5433
JEVOPS_DB_USER=jevops
JEVOPS_DB_PASSWORD=jevops
JEVOPS_DB_NAME=jevops

# Redis
JEVOPS_REDIS_HOST=localhost
JEVOPS_REDIS_PORT=6379
JEVOPS_REDIS_DB=0

# Jev Provider
JEVOPS_JEV_PROVIDER=mock
JEVOPS_JEV_MODEL=jev-latest
JEVOPS_JEV_API_KEY=
JEVOPS_JEV_TIMEOUT=30.0
JEVOPS_JEV_MAX_RETRIES=3

# TypeSafe SDK (used when JEVOPS_JEV_PROVIDER=typesafe)
TYPESAFE_API_KEY=

# Security
JEVOPS_SECURITY_API_KEY_PEPPER=change-me-in-production
JEVOPS_SECURITY_CORS_ORIGINS=["http://localhost:3000"]
JEVOPS_SECURITY_RATE_LIMIT_PER_MINUTE=60
JEVOPS_SECURITY_MAX_REQUEST_SIZE_BYTES=1048576

# OpenTelemetry
JEVOPS_OTEL_ENABLED=false
JEVOPS_OTEL_ENDPOINT=http://localhost:4317
JEVOPS_OTEL_SERVICE_NAME=jevops-api

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
